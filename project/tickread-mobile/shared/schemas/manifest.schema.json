{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "Manifest",
  "description": "Index of the question bank shards produced by build_deck.py.",
  "type": "object",
  "required": ["version", "generatedAt", "setupLength", "shards"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Incremented when the shard format changes in a breaking way."
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of when the bank was built."
    },
    "setupLength": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of setup bars in every question in this bank."
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timeframe", "file", "count", "assetClasses", "horizons"],
        "additionalProperties": true,
        "properties": {
          "timeframe": {
            "type": "string",
            "enum": ["1m", "1h", "1d", "1mo"]
          },
          "file": {
            "type": "string",
            "description": "Filename relative to the manifest, e.g. questions-1d.json."
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "assetClasses": {
            "type": "array",
            "items": { "type": "string" }
          },
          "horizons": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    }
  }
}
